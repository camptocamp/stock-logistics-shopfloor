<odoo>
    <template
        id="shopfloor_app_assets"
        inherit_id="shopfloor_mobile_base.shopfloor_app_assets"
    >
        <script id="script_app_main" position="before">
            <!-- Scenario -->
            <script id="script_scenario_single_product_transfer" type="module">
                import "/shopfloor_single_product_transfer_mobile/static/src/scenario/single_product_transfer.esm.js";
