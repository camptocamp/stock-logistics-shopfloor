<odoo>
    <template
        id="shopfloor_app_assets"
        inherit_id="shopfloor_mobile.shopfloor_app_assets"
    >
        <script id="script_component_picking_select" position="after">
            <script id="script_component_picking_select_dangerous_goods" type="module">
                import "/shopfloor_dangerous_goods_mobile/static/wms/src/components/picking_select.esm.js";
            </script>
        </script>
        <link id="link_css_main" position="after">
            <link
                id="link_css_dangerous_goods"
                t-att-href="static_url('/shopfloor_dangerous_goods_mobile/static/wms/src/css/dangerous_goods.css')"
                rel="stylesheet"
            />
        </link>
    </template>
    <template
        id="shopfloor_app_demo_assets"
        inherit_id="shopfloor_mobile_base.shopfloor_app_demo_assets"
    >
        <xpath expr="//script[last()]" position="after">
            <script id="script_demo_checkout" type="module">
                import "/shopfloor_dangerous_goods_mobile/static/wms/src/js/demo/demo.checkout.esm.js";
            </script>
        </xpath>
    </template>
</odoo>
