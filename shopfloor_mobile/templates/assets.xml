                rel="stylesheet"
            />
            <script id="script_scren_override" type="module">
                import "/shopfloor_mobile/static/wms/src/screen.esm.js";
            </script>
            <script id="script_wms_utils" type="module">
                import "/shopfloor_mobile/static/wms/src/wms_utils.esm.js";
