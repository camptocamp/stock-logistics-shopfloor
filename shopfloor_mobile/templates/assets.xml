                import "/shopfloor_mobile/static/wms/src/demo/demo.zone_picking.esm.js";
            </script>
            <script id="script_demo_location_content_transfer" type="module">
                import "/shopfloor_mobile/static/wms/src/demo/demo.location_content_transfer.esm.js";
            </script>
            <script id="script_demo_components" type="module">
                import "/shopfloor_mobile/static/wms/src/demo/demo.components.esm.js";
